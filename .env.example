# ---- LLM API (Anthropic OR OpenAI-compatible) ----

# API key. Any one of these works; checked in this order:
#   AUTONOVEL_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Provider: "anthropic" or "openai".
# Auto-detected from AUTONOVEL_API_BASE_URL if unset
# (URL contains "anthropic" -> anthropic; otherwise -> openai).
# AUTONOVEL_API_PROVIDER=anthropic

# Base URL. Examples:
#   https://api.anthropic.com           (Anthropic, default)
#   https://api.openai.com/v1           (OpenAI)
#   https://api.deepseek.com            (DeepSeek)
#   http://localhost:11434/v1           (Ollama)
#   http://localhost:8000/v1            (vLLM / LiteLLM)
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# Model names. Use Anthropic IDs (e.g. claude-sonnet-4-6) when pointing
# at Anthropic; OpenAI-style IDs (e.g. gpt-4o, deepseek-chat, llama3:70b)
# for OpenAI-compatible endpoints.
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6
AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# ---- Image & audio (unchanged) ----

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

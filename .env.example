# ---- LLM API（Anthropic 或 OpenAI 兼容端点）----

# API key。三个变量名任选其一；按下列顺序检测：
#   AUTONOVEL_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# 服务商："anthropic" 或 "openai"。
# 未设置时自动从 AUTONOVEL_API_BASE_URL 推断
# （URL 含 "anthropic" → anthropic；其他 → openai）。
# AUTONOVEL_API_PROVIDER=anthropic

# Base URL 示例：
#   https://api.anthropic.com           （Anthropic，默认）
#   https://api.openai.com/v1           （OpenAI）
#   https://api.deepseek.com            （DeepSeek）
#   http://localhost:11434/v1           （Ollama 本地）
#   http://localhost:8000/v1            （vLLM / LiteLLM 本地）
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# 模型名。指向 Anthropic 时用 Anthropic ID（如 claude-sonnet-4-6）；
# 指向 OpenAI 兼容端点时用 OpenAI 风格 ID（如 gpt-4o, deepseek-chat,
# llama3:70b 等）。
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6
AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# ---- 配图与有声书（可选）----

# fal.ai key（封面与章节插图，使用 Nano Banana 2 模型）
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key（多人配音有声书）
# 注：ElevenLabs 的中文 voice 选项有限。请在 audiobook_voices.json 里把
# voice_id 占位符替换为 ElevenLabs Voice Library 中 language: zh 的实际 ID。
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
